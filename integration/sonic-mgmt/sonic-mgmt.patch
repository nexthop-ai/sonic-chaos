diff --git a/tests/platform_tests/test_port_toggle.py b/tests/platform_tests/test_port_toggle.py
index 8b0cc65..628400a 100644
--- a/tests/platform_tests/test_port_toggle.py
+++ b/tests/platform_tests/test_port_toggle.py
@@ -30,3 +30,32 @@ class TestPortToggle(object):
         """
         duthost = duthosts[enum_rand_one_per_hwsku_frontend_hostname]
         port_toggle(duthost, tbinfo)
+
+    # orchagent's dispatch thread is held at 70% CPU for this test only, applied before the test
+    # body runs and released after it. Every shutdown/startup below lands in APPL_DB and has to be
+    # serviced by PortsOrch through that one busy loop, so this is the same toggle-and-verify as
+    # above with orchagent able to spend only 30 ms of every 100 ms actually working.
+    #
+    # spin, not cpu: a cpu= cap only says "at most 70%", and an idle orchagent under a cap still
+    # reads ~0% and services everything, so the test would pass without testing anything. spin
+    # burns the CPU itself, inside epoll_wait. 70 is below the stall point (100 never forwards the
+    # call at all), so the loop still turns: a pass means port admin changes survive a busy
+    # orchagent, not that orchagent was idle.
+    #
+    # ttl is the switch-side safety net if the harness dies mid-test, not the hold time; the hold
+    # is the test's own duration.
+    @pytest.mark.chaos("spin", "orchagent:70:ttl=600")
+    def test_port_toggle_orchagent_busy(self, duthosts, enum_rand_one_per_hwsku_frontend_hostname,
+                                        bring_up_dut_interfaces, tbinfo):
+        """
+        Validates that port toggle still works while orchagent is held at 70% CPU.
+
+        Test steps:
+            1.) sonic-chaos pins orchagent's dispatch loop at 70% before the body runs.
+            2.) Flap all interfaces on DUT one by one.
+            3.) Verify interfaces are up correctly.
+
+        Pass Criteria: All interfaces are up correctly, under load.
+        """
+        duthost = duthosts[enum_rand_one_per_hwsku_frontend_hostname]
+        port_toggle(duthost, tbinfo)
